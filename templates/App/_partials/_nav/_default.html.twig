                <svg viewBox="0 0 93.9047 93.9079" style="height: 1em; fill: currentColor;" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <style>
                      .uuid-0facdc91-f191-461a-ae7f-8912152014a7 {
                        fill-rule: evenodd;
                      }
                    </style>
                  </defs>
                  <path class="uuid-0facdc91-f191-461a-ae7f-8912152014a7" d="M0,57.3301c1.2109,19.645,16.93,35.363,36.574,36.574v-17.918c-9.7773-1.1211-17.535-8.8789-18.656-18.656H0ZM64.918,17.6542l11.344,11.344-23.668,23.73c-1.5312,1.5352-3.2031,2.4883-5.3047,3.0273l-11.059,2.8242c-.5156.1328-.9805-.3359-.8516-.8477l2.8008-11.047c.5312-2.1016,1.4844-3.7773,3.0156-5.3086l23.7229-23.7222ZM86.098,20.2245l5.2578-5.2656c3.4062-3.4102,3.4141-8.9219-.0703-12.41-3.3828-3.3828-8.9297-3.4141-12.348,0l-5.2578,5.2578-3.6797-3.6797c-1.6016-1.6016-4.2109-1.6016-5.8125,0-1.6484,1.6484-1.6406-4.2422-.0352-5.8477l19.699,19.699c1.6016,1.6016,4.2109,1.6016,5.8125,0,1.6484-1.6484,1.6406-4.2422.0352-5.8477l-3.6055-3.6055.0045.004ZM36.575,15.869C16.93,17.0799,1.212,32.799.001,52.443h17.918c1.1211-9.7773,8.8789-17.535-18.656-18.656V15.869ZM55.997,19.662c-4.4414-2.1445-9.3516-3.4727-14.531-3.793v17.918c.1211.0156.2422.0273.3633.0469l14.168-14.168-.0003-.0039ZM60.122,52.4429h17.918c-.3203-5.1719-1.6445-10.074-3.7812-14.508l-14.172,14.207c.0117.1016.0234.1992.0352.3008v.0002ZM41.466,75.99v17.918c19.645-1.2109,35.363-16.93,36.574-36.574h-17.918c-1.1211,9.7773-8.8789,17.535-18.656,18.656Z"/>
