<li>
    <form class="search"
          name="search"
          method="get"
          data-autocomplete-url="/search/autocomplete/"
          action="{{ path('app_search_index') }}"
          data-controller="search"
    >
        <div>
            <input id="search_term"
                   data-action="keyup->search#search click->search#open"
                   name="search[term]"
                   class="search-input placeholder"
                   placeholder="{{ 'menu.search'|trans }}"
                   autocomplete="off"
            >
            <input id="search_searchInData" type="checkbox" value="1" name="search[searchInData]" {{ app.user.searchInDataByDefaultEnabled ? 'checked' }}>
        </div>
        <ul class="autocomplete-results hidden" data-search-target="resultsWrapper"></ul>
    </form>
</li>

<li class="{{ 'app_collection' in route or 'app_item' in route ? 'current' }} sidebar-element">
    <a href="{{ path('app_collection_index') }}">
        <i class="fa fa-archive fa-fw"></i>
        <span>{{ 'menu.collections'|trans }}</span>
    </a>
</li>

{% if isFeatureEnabled('locator') %}
    <li class="{{ 'app_locator' in route ? 'current' }} sidebar-element">
        <a href="{{ path('app_locator') }}">
            <i class="fa fa-map-marker fa-fw"></i>
            <span>Locator Grid</span>
        </a>
    </li>
    
    <!-- COLOR TRACKER BUTTON WITH CUSTOM SVG ICON -->
