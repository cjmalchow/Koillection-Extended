{% extends 'layout.html.twig' %}
{% block title %}Color Tracker{% endblock %}
{% block breadcrumb %}
    <div class="breadcrumb">
        <a href="{{ path('app_collection_index') }}">{{ 'menu.collections'|trans }}</a>
        <i class="fa fa-angle-right separator"></i>
        <span>Color Tracker</span>
    </div>
{% endblock %}
{% block content %}
    <div class="collection-header">
        <div class="title-block">
            <h1><i class="fa fa-paint-brush fa-fw"></i> Color Tracker</h1>
        </div>
    </div>
    <div class="content-block" style="padding: 0; overflow: hidden; height: 75vh; border-radius: 4px; box-shadow: 0 2px 2px 0 rgba(0,0,0,0.14);">
        <iframe src="http://localhost:8503" width="100%" height="100%" style="border: none;"></iframe>
    </div>
{% endblock %}