{% set sortingProperty = displayConfiguration.sortingProperty %}
{% set sortingDirection = displayConfiguration.sortingDirection %}

<!-- BULK ACTIONS BAR (Hidden by default) -->
<div id="bulk-actions-bar" style="display: none; align-items: center; background-color: #26a69a; color: white; padding: 15px; border-radius: 4px; margin-bottom: 15px; box-shadow: 0 2px 2px 0 rgba(0,0,0,0.14);">
    <span style="font-size: 1.2em; margin-right: auto;">
        <strong id="selected-count">0</strong> items selected
    </span>
    
    <button id="btn-bulk-duplicate" class="btn waves-effect waves-light blue" style="margin-right: 10px;">
        <i class="fa fa-copy fa-fw"></i> Duplicate
    </button>
    
    <button id="btn-bulk-move" class="btn waves-effect waves-light orange" style="margin-right: 10px;">
        <i class="fa fa-folder-open fa-fw"></i> Move
    </button>
    
    <button id="btn-bulk-delete" class="btn waves-effect waves-light red">
        <i class="fa fa-trash fa-fw"></i> Delete
    </button>
</div>
<table class="highlight items-table" data-controller="table">
    <thead>
        <tr>
            <th style="width: 40px; text-align: center;">
                <label>
                    <input type="checkbox" id="selectAllCheckboxes" />
                    <span></span>
                </label>
            </th>
            <th></th>
            <th>
                {{ 'label.name'|trans }}
                <span>
                    <i class="fa fa-long-arrow-up {{ sortingProperty is null and sortingDirection == 'ASC' ? 'active' }}" data-column="name" data-direction="asc" data-action="click->table#sort" data-table-target="sorter"></i>
                    <i class="fa fa-long-arrow-down {{ sortingProperty is null and sortingDirection == 'DESC' ? 'active' }}" data-column="name" data-direction="desc" data-action="click->table#sort" data-table-target="sorter"></i>
                </span>
            </th>

            {% if displayConfiguration.showItemQuantities %}
                <th>
                    {{ 'label.quantity'|trans }}
                    <span>
                    <i class="fa fa-long-arrow-up {{ sortingProperty == 'koi-quantity' and sortingDirection == 'ASC' ? 'active' }}" data-column="koi-quantity" data-direction="asc" data-action="click->table#sort" data-table-target="sorter"></i>
                    <i class="fa fa-long-arrow-down {{ sortingProperty == 'koi-quantity' and sortingDirection == 'DESC' ? 'active' }}" data-column="koi-quantity" data-direction="desc" data-action="click->table#sort" data-table-target="sorter"></i>
                </span>
                </th>
            {% endif %}

            {% for column in displayConfiguration.columns %}
                <th class="center hide-on-small-and-down">
                    {{ column }}
                    <span>
                        <i class="fa fa-long-arrow-up {{ sortingProperty == column and sortingDirection == 'ASC' ? 'active' }}" data-column="{{ column }}" data-direction="asc" data-action="click->table#sort" data-table-target="sorter"></i>
                        <i class="fa fa-long-arrow-down {{ sortingProperty == column and sortingDirection == 'DESC' ? 'active' }}" data-column="{{ column }}" data-direction="desc" data-action="click->table#sort" data-table-target="sorter"></i>
                    </span>
                </th>
            {% endfor %}
            {% if context == 'default' %}
                {% if displayConfiguration.showVisibility %}
                    <th class="center">{{ 'label.visibility'|trans }}</th>
                {% endif %}
                {% if displayConfiguration.showActions %}
                    <th class="center">{{ 'label.actions'|trans }}</th>
                {% endif %}
            {% endif %}
        </tr>
    </thead>

    <tbody>
        {% for item in items|naturalSorting(displayConfiguration) %}
            {% set link = path('app_item_show'|applyContext, {'id': item.id}) %}
            <tr class="list-element resize-element" data-title="{{ item.name }}" data-filter-target="element">
                <td style="text-align: center; position: relative; z-index: 10;">
                    <label>
                        <input type="checkbox" class="item-checkbox" value="{{ item.id }}" />
                        <span></span>
                    </label>
                </td>
                <td>
                    <a class="table-link" href="{{ link }}"></a>
                    {% if item.imageSmallThumbnail %}
                        <img src="{{ asset(item.imageSmallThumbnail) }}" loading="lazy" class="{{ item.isCurrentlyLoaned() ? 'loaned' }}">
                    {% endif %}
                </td>
                <td data-column="name">
                    <span data-value="{{ item.name }}" data-type="string">
                    <a class="table-link" href="{{ link }}"></a>
                    {{ item.name|u.truncate(50, '...') }}
                </td>

                {% if displayConfiguration.showItemQuantities %}
                    <td data-column="koi-quantity">
                    <span data-value="{{ item.quantity }}" data-type="number">
                    <a class="table-link" href="{{ link }}"></a>
                    {{ item.quantity }}
                    </td>
                {% endif %}

                {% for column in displayConfiguration.columns %}
                    {% set datum = item.getDatumByLabel(column) %}

                    <td class="center hide-on-small-and-down" data-column="{{ column }}">
                        {% if datum is not null %}
                            {% if datum.type != 'link' %}
                                <a class="table-link" href="{{ link }}"></a>
                            {% endif %}

                            {% include 'App/Datum/_display_value/_' ~ datum.type ~ '.html.twig' with {'datum': datum} only %}
                        {% else %}
                            <span data-value="">
                            <a class="table-link" href="{{ link }}"></a>
                            -
                        {% endif %}
                    </td>
                {% endfor %}
                {% if context == 'default' %}
                    {% if displayConfiguration.showVisibility %}
                        <td class="center">
                            {% include 'App/_partials/_visibility.html.twig' with {'visibility': item.finalVisibility} only %}
                        </td>
                    {% endif %}
                    {% if displayConfiguration.showActions %}
                        <td class="table-actions center" style="position: relative; z-index: 10;">
                            <a href="{{ path('app_item_edit', {id: item.id}) }}" title="{{ 'tooltip.edit'|trans }}">
                                <i class="fa fa-pencil fa-fw"></i>
                            </a>
                            {% include 'App/_partials/_icon/_delete.html.twig' with {
                                path: path('app_item_delete', {id: item.id}),
                                message: 'message.delete.item'
                            } only %}
                        </td>
                    {% endif %}
                {% endif %}
            </tr>
        {% endfor %}
    </tbody>
</table>
<!-- JAVASCRIPT TO CONTROL CHECKBOXES -->
<script>
    setTimeout(function() {
        const selectAllBox = document.getElementById('selectAllCheckboxes');
        const itemBoxes = document.querySelectorAll('.item-checkbox');
        const bulkBar = document.getElementById('bulk-actions-bar');
        const countText = document.getElementById('selected-count');

        function updateBulkBar() {
            const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
            if (checkedBoxes.length > 0) {
                bulkBar.style.display = 'flex'; // Changed from 'block' to 'flex' for perfect alignment!
                countText.innerText = checkedBoxes.length;
            } else {
                bulkBar.style.display = 'none';
            }
        }

        if (selectAllBox) {
            selectAllBox.addEventListener('change', function() {
                itemBoxes.forEach(box => {
                    box.checked = selectAllBox.checked;
                });
                updateBulkBar();
            });
        }

        itemBoxes.forEach(box => {
            box.addEventListener('change', updateBulkBar);
        });
    // --- NEW: DUPLICATE BUTTON LOGIC ---
        const btnDuplicate = document.getElementById('btn-bulk-duplicate');
        if (btnDuplicate) {
            btnDuplicate.addEventListener('click', function() {
                // Get all the checked IDs
                const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
                const ids = Array.from(checkedBoxes).map(box => box.value);

                // Ask for confirmation
                if (confirm('Are you sure you want to duplicate ' + ids.length + ' item(s)?')) {
                    
                    // Change button text to show it's working
                    btnDuplicate.innerHTML = '<i class="fa fa-spinner fa-spin fa-fw"></i> Working...';
                    
                    // Send the IDs to our new PHP backend
                    fetch('/items/bulk-duplicate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({ ids: ids })
                    }).then(response => {
                        if (response.ok) {
                            window.location.reload(); // Refresh the page to see the copies!
                        } else {
                            alert('Something went wrong!');
                            btnDuplicate.innerHTML = '<i class="fa fa-copy fa-fw"></i> Duplicate';
                        }
                    });
                }
            });
        }
    }, 500);
</script>