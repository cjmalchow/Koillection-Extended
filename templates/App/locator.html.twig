{% extends 'layout.html.twig' %}
{% block title %}Storage Grid Visualizer{% endblock %}
{% block breadcrumb %}
    <div class="breadcrumb">
        <a href="{{ path('app_collection_index') }}">{{ 'menu.collections'|trans }}</a>
        <i class="fa fa-angle-right separator"></i>
        <span>Storage Grid</span>
    </div>
{% endblock %}
{% block content %}
    <div class="collection-header">
        <div class="title-block">
            <h1><i class="fa fa-map-marker fa-fw"></i> Storage Grid Visualizer</h1>
        </div>
        <div class="btn-holder">
            <a href="{{ path('app_collection_index') }}" class="btn waves-effect waves-light" style="background-color: #26a69a; color: white; border-radius: 4px;">
                <i class="fa fa-arrow-left fa-fw"></i> Return to Collections
            </a>
        </div>
    </div>
    <div class="content-block" style="padding: 0; overflow: hidden; height: 75vh; border-radius: 4px; box-shadow: 0 2px 2px 0 rgba(0,0,0,0.14);">
        <iframe id="locator-iframe" width="100%" height="100%" style="border: none;"></iframe>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const currentHost = window.location.hostname;
            const currentPort = window.location.port;
            
            // Default to the Sandbox Grid Visualizer port
            let gridPort = '8501'; 
            
            // If the browser sees we are on the Production Koillection port (8144),
            // switch to the Production Grid Visualizer port (8502)!
            if (currentPort === '8144') {
                gridPort = '8502';
            }
            
            // Build the final URL and inject it into the iframe
            document.getElementById('locator-iframe').src = "http://" + currentHost + ":" + gridPort;
        });
    </script>
{% endblock %}